# --- PostgreSQL (conteneur Docker) ---
POSTGRES_USER=bouquineo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bouquineo
POSTGRES_PORT=5432

# URL utilisee par le script, qui tourne sur l'HOTE et vise le port publie
DATABASE_URL=postgresql://bouquineo:change-me@localhost:5432/bouquineo

# --- Collecteur ---
# User-Agent explicite : qui scrape, pourquoi, comment me joindre
USER_AGENT=Bouquineo-Scraper/1.0 (formation Simplon; +mailto:elie.lecas@proferm.net)
# Temporisation entre deux requetes, en secondes (justifiee dans le README)
REQUEST_DELAY=0.5
REQUEST_TIMEOUT=15
# Timeout de connexion a PostgreSQL (secondes, minimum libpq : 2)
DB_CONNECT_TIMEOUT=10
# Arret si N echecs CONSECUTIFS : signal que le site a change
MAX_CONSECUTIVE_FAILURES=20
